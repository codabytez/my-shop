# ── Database (Neon or Supabase Postgres) ────────────────────────────
# Neon:     postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Supabase: postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Public URL of the site (used for OAuth callbacks and links in emails)
AUTH_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Mailgun ─────────────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
# Optional: defaults to "Morrow <orders@MAILGUN_DOMAIN>"
MAILGUN_FROM="Morrow <orders@mg.yourdomain.com>"
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region
MAILGUN_API_BASE=https://api.mailgun.net
