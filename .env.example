# ── Database (Neon or Supabase Postgres) ────────────────────────────
# Neon:     postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Supabase: postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Auth.js ─────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Public URL of the site (OAuth callbacks, links in emails).
# Locally: http://localhost:3000. On Vercel: your production URL, e.g. https://my-shop.vercel.app
AUTH_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Resend ──────────────────────────────────────────────────────────
# https://resend.com/api-keys (a "Sending access" key is enough)
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend → Domains
EMAIL_FROM="Morrow <orders@yourdomain.com>"
